{
  "color": {
    "$type": "color",
    "primary": { "$value": "#5e90db" }
  },
  "typography": {
    "fontSize": {
      "$type": "dimension",
      "base": { "$value": "16pt" }
    }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": "20px" },
    "lg": { "$value": "10px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(0, 0, 0, 0.2)",
        "offsetX": "-10px",
        "offsetY": "0px",
        "blur": "10px",
        "spread": "0px"
      }
    }
  }
}
