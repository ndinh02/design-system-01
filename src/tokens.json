{
  "color": {
    "$type": "color",
    "primary": { "$value": "#5e90db" },
    "textPrimary": { "$value": "#1a1a1a" },
    "textSecondary": { "$value": "#595959" },
    "surface": { "$value": "#ffffff" }
  },
  "typography": {
    "fontSize": {
      "$type": "dimension",
      "base": { "$value": "16pt" },
      "lg": { "$value": "20px" }
    },
    "fontWeight": {
      "$type": "number",
      "bold": { "$value": 700 }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": "20px" },
    "lg": { "$value": "10px" },
    "sm": { "$value": "6px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(0, 0, 0, 0.2)",
        "offsetX": "-10px",
        "offsetY": "0px",
        "blur": "10px",
        "spread": "0px"
      }
    }
  }
}
