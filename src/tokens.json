{
  "color": {
    "$type": "color",
    "primary": { "$value": "#5e90db" },
    "accent-soft": { "$value": "rgba(94, 144, 219, 0.12)" },
    "surface": { "$value": "#ffffff" },
    "surface-canvas": { "$value": "#f7f7f5" },
    "text": { "$value": "#1a1a18" },
    "text-muted": { "$value": "#6b6b66" },
    "text-on-primary": { "$value": "#ffffff" },
    "border": { "$value": "#e4e4df" },
    "success": { "$value": "#4d9d6b" },
    "warning": { "$value": "#c28f2c" },
    "danger": { "$value": "#c25450" }
  },
  "typography": {
    "fontSize": {
      "$type": "dimension",
      "sm": { "$value": "13pt" },
      "base": { "$value": "16pt" },
      "lg": { "$value": "20pt" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "lg": { "$value": "10px" },
    "button": { "$value": "20px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(0, 0, 0, 0.2)",
        "offsetX": "-10px",
        "offsetY": "0px",
        "blur": "10px",
        "spread": "0px"
      }
    }
  }
}
